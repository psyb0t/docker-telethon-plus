# Copy to .env and fill in. .env is gitignored.

# Required — Telegram app credentials (https://my.telegram.org/apps)
TELETHON_API_ID=123456
TELETHON_API_HASH=replace-me

# Required — string session minted via `make login`
TELETHON_SESSION=replace-me

# Optional — set to require Bearer token auth on all endpoints except /healthz
# TELETHON_AUTH_KEY=replace-with-a-strong-random-secret

# Optional
TELETHON_HTTP_LISTEN_ADDRESS=0.0.0.0:8080
TELETHON_LOG_LEVEL=INFO
TELETHON_REQUEST_TIMEOUT=60
TELETHON_FLOOD_SLEEP_THRESHOLD=60
TELETHON_DEVICE_MODEL=docker-telethon-plus
TELETHON_SYSTEM_VERSION=1.0
TELETHON_APP_VERSION=1.0
TELETHON_DOWNLOAD_DIR=/tmp/telethon-plus
# TELETHON_PROXY=socks5://user:pass@host:port

# Throttling — defaults are conservative; tune if you understand the limits.
# Set TELETHON_THROTTLE_ENABLED=false to disable all of this entirely.
TELETHON_THROTTLE_ENABLED=true
TELETHON_THROTTLE_GLOBAL_INTERVAL_MS=50
TELETHON_THROTTLE_JITTER_MS=200
TELETHON_THROTTLE_PER_CHAT_INTERVAL_MS=1100
TELETHON_THROTTLE_PER_CHAT_READ_INTERVAL_MS=250
TELETHON_THROTTLE_ADAPTIVE=true

# Per-method token buckets — caps for the dangerous methods. The default
# values aim to stay safely below Telegram's server-side soft limits.
TELETHON_BUCKET_RESOLVE_PER_MIN=5
TELETHON_BUCKET_GET_FULL_PER_MIN=10
TELETHON_BUCKET_JOIN_PER_HOUR=5
TELETHON_BUCKET_CREATE_PER_HOUR=5
TELETHON_BUCKET_SEND_PER_MIN=20
TELETHON_BUCKET_READ_PER_MIN=600

# Persistent entity cache — skips resolveUsername on handles we've seen.
# Set TELETHON_CACHE_ENABLED=false to disable. Path is inside the
# container; mount a host volume to keep it across rebuilds.
TELETHON_CACHE_ENABLED=true
TELETHON_CACHE_PATH=/cache/entities.json
TELETHON_CACHE_TTL_SECONDS=604800

# Safety switches.
# READ_ONLY: 403 on every write endpoint. Reads + status still work.
# DRY_RUN:   accept writes but only log + echo what would happen.
TELETHON_READ_ONLY=false
TELETHON_DRY_RUN=false

# Observability.
TELETHON_LOG_JSON=false
TELETHON_METRICS_ENABLED=true

# Updates / webhook.
# UPDATES_ENABLED: Register incoming-event handlers and expose /ws/updates.
# POST_TO_URL:     Outbound webhook for every event (in addition to WS).
TELETHON_UPDATES_ENABLED=true
TELETHON_UPDATES_BUFFER_SIZE=256
# TELETHON_POST_TO_URL=https://your-app.example/hook
TELETHON_POST_TO_TIMEOUT=10

# Testing (used by `make test`)
TEST_CHAT=me
