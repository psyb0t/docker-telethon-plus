# Copy to .env and fill in. .env is gitignored.

# Required: Telegram app credentials (https://my.telegram.org/apps)
TELETHON_API_ID=123456
TELETHON_API_HASH=replace-me

# Required: string session minted via `make login` or login.py
TELETHON_SESSION=replace-me

# Required: chat to send test messages to. Use "me" for Saved Messages.
TEST_CHAT=me

# Optional: log level inside container during tests
TELETHON_LOG_LEVEL=INFO

# Optional: chats outside the suite. A test whose setting is empty is skipped.
# A public channel to read (read only).
TEST_PUBLIC_CHANNEL=@telegram
# A public channel or group the account is not in: joined, then left.
TEST_JOIN_CHAT=
# A t.me/+hash invite to a chat the account is not in: joined, then left.
TEST_INVITE_LINK=
# A user or bot you control: promoted, demoted, banned, unbanned and kicked
# in a group the suite creates and deletes. Defaults to the TEST_BOT_TOKEN bot.
TEST_PEER_USER=
# The token of a bot you own, from @BotFather. The update tests have it
# message the account, because what the server does itself raises no event.
# The suite sends the bot /start from the account first.
TEST_BOT_TOKEN=
